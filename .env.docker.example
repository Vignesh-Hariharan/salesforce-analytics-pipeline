# Used by docker-compose. Each value is the base64-encoded form of the real
# secret; the Kestra flows decode them before invoking Python. Keep this in
# sync with .env.example (one-to-one mapping minus DOMAIN/DATABASE/SCHEMA/
# WAREHOUSE which are hard-coded in the flows).
#
# To encode:   printf 'your-real-secret' | base64
#
# This file is NOT secure. Base64 is encoding, not encryption — anyone with
# read access to the file can recover the original secret instantly.
KESTRA_SECRET_SNOWFLAKE_ACCOUNT=
KESTRA_SECRET_SNOWFLAKE_USER=
KESTRA_SECRET_SNOWFLAKE_PASSWORD=
KESTRA_SECRET_SALESFORCE_USERNAME=
KESTRA_SECRET_SALESFORCE_PASSWORD=
KESTRA_SECRET_SALESFORCE_SECURITY_TOKEN=
KESTRA_SECRET_SALESFORCE_DOMAIN=
KESTRA_SECRET_GEMINI_API_KEY=
KESTRA_SECRET_SLACK_WEBHOOK_URL=
KESTRA_SECRET_ASANA_ACCESS_TOKEN=
KESTRA_SECRET_ASANA_PROJECT_GID=
