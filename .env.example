# Local Python development. Copy to .env and fill in real values.
# For Kestra/docker-compose, use .env.docker.example instead — that file
# expects KESTRA_SECRET_* names with base64-encoded values.

SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_DATABASE=SALES_ANALYTICS
SNOWFLAKE_SCHEMA=OPPORTUNITIES
SNOWFLAKE_WAREHOUSE=COMPUTE_WH

SALESFORCE_USERNAME=
SALESFORCE_PASSWORD=
SALESFORCE_SECURITY_TOKEN=
# 'login' for production, 'test' for sandbox.
SALESFORCE_DOMAIN=login

GEMINI_API_KEY=
SLACK_WEBHOOK_URL=

# Optional. Required only if you want the pipeline to update Asana tasks.
ASANA_ACCESS_TOKEN=
ASANA_PROJECT_GID=
